  "components": [
    {
      "name": "Button",
      "group": "Actions",
      "summary": "Buttons do one thing, named by a verb in sentence case: \"Download kit\", \"Cut sheets\", \"Add light\"."
    },
    {
      "name": "Checks",
      "group": "Feedback",
      "summary": "All of a kit's problems live behind one pill in the header: a dot (success, warning or danger), the word and a count — \"All good\", \"2 to check\", \"1 blocks cutt…"
    },
    {
      "name": "Chip",
      "group": "Feedback",
      "summary": "A small status or property label: \"Calibrated\" (success), \"Not calibrated\" (warning), \"Knife Blade\", \"3 LEDs\" (light)."
    },
    {
      "name": "DesignScreen",
      "group": "Showcase",
      "summary": "The Design step laid out with the system: header (mark, kit name, StepNav, compact KitMeter, Checks pill, Undo, Share), a three-button tool rail, the stage wit…",
      "page": true
    },
    {
      "name": "EmptyState",
      "group": "Feedback",
      "summary": "When a step has nothing to show yet, Mimi says what will appear and offers the first action."
    },
    {
      "name": "Field",
      "group": "Inputs",
      "summary": "A labelled input."
    },
    {
      "name": "Inspector",
      "group": "Panels",
      "summary": "The right-hand panel shows only the selected thing: a piece, the room, an opening, a light."
    },
    {
      "name": "KitMeter",
      "group": "Feedback",
      "summary": "The kit's vital numbers in measure: model size, parts, sheets and cut time."
    },
    {
      "name": "Notice",
      "group": "Feedback",
      "summary": "An inline message about the thing in front of you."
    },
    {
      "name": "PieceCard",
      "group": "Panels",
      "summary": "A tile in the library drawer: a thumbnail from the renderer, the piece name, and two facts — difficulty (three dots plus the word in the tooltip) and part coun…"
    },
    {
      "name": "Segmented",
      "group": "Actions",
      "summary": "A segmented control switches between views of the same thing: Plan ↔ 3D on the stage, Day ↔ Night, Warm ↔ Amber."
    },
    {
      "name": "SheetCard",
      "group": "Panels",
      "summary": "One material sheet on the Make step: material swatch and name, the sheet drawing (cut lines in ink on kraft, folds dashed in score), file buttons for the chose…"
    },
    {
      "name": "SlotPicker",
      "group": "Inputs",
      "summary": "The fit test: a drawn comb with five numbered slots around the board's nominal thickness, and one button per slot."
    },
    {
      "name": "StepNav",
      "group": "Navigation",
      "summary": "The header's step nav is the spine of the app: 1 Design · 2 Light · 3 Make · 4 Build."
    },
    {
      "name": "Toast",
      "group": "Feedback",
      "summary": "A short confirmation that floats at the bottom centre for four seconds: \"Added floor lamp\", \"Link copied\", \"Removed window\" with an Undo button."
    }
  ],
