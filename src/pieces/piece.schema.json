{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fjarnskaggl.github.io/mimimaker/piece.schema.json",
  "title": "mimimaker piece",
  "description": "A parametric furniture or decor piece. Numbers may be written as expressions (strings) over the piece's parameters, `t` (material thickness, mm) and `let` names. Structural rules are in this schema; meaning (names in scope, defaults in range) is checked by validatePiece() in schema.js.",
  "type": "object",
  "required": ["id", "label", "theme", "placement", "mat", "params", "defaults", "components"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "label": { "type": "string", "minLength": 1 },
    "theme": { "type": "string", "minLength": 1 },
    "placement": { "enum": ["floor", "wall"] },
    "mat": { "enum": ["board", "card", "fabric"], "description": "Preferred material kind for new items." },
    "params": { "type": "array", "items": { "$ref": "#/$defs/param" } },
    "defaults": { "type": "object", "additionalProperties": { "type": ["number", "string"] } },
    "size": { "$ref": "#/$defs/vec3", "description": "Footprint [w, d, h] used for placement; defaults to [w, d, h]." },
    "let": { "$ref": "#/$defs/lets" },
    "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/componentEntry" } },
    "note": { "type": "string" },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "description": "Library search words, e.g. storage, seating, wall-mounted." },
    "difficulty": { "enum": [1, 2, 3], "description": "1 Easy, 2 Medium, 3 Tricky." }
  },
  "$defs": {
    "expr": { "type": ["number", "string"], "description": "A number or an expression such as \"d - t\" or \"min(w * 0.08, back * 0.3)\"." },
    "vec2": { "type": "array", "items": { "$ref": "#/$defs/expr" }, "minItems": 2, "maxItems": 2 },
    "vec3": { "type": "array", "items": { "$ref": "#/$defs/expr" }, "minItems": 3, "maxItems": 3 },
    "lets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/expr" } },
    "face": { "enum": ["bottom", "top", "front", "back", "left", "right"] },
    "param": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["key", "label", "type", "min", "max"],
          "properties": {
            "key": { "type": "string", "pattern": "^[A-Za-z_]\\w*$" }, "label": { "type": "string" },
            "type": { "const": "number" }, "min": { "type": "number" }, "max": { "type": "number" },
            "step": { "type": "number", "exclusiveMinimum": 0 }, "unit": { "enum": ["cm"] }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["key", "label", "type", "options"],
          "properties": {
            "key": { "type": "string", "pattern": "^[A-Za-z_]\\w*$" }, "label": { "type": "string" },
            "type": { "const": "select" }, "options": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      ]
    },
    "repeat": {
      "type": "object", "required": ["repeat", "as", "each"], "additionalProperties": false,
      "description": "Repeat `each` round(repeat) times with `as` = 0, 1, 2…",
      "properties": {
        "repeat": { "$ref": "#/$defs/expr" }, "as": { "type": "string", "pattern": "^[A-Za-z_]\\w*$" },
        "let": { "$ref": "#/$defs/lets" }, "when": { "$ref": "#/$defs/expr" }, "each": {}
      }
    },
    "componentEntry": { "oneOf": [{ "$ref": "#/$defs/box" }, { "$ref": "#/$defs/flat" }, { "allOf": [{ "$ref": "#/$defs/repeat" }, { "properties": { "each": { "$ref": "#/$defs/componentEntry" } } }] }] },
    "shapeEntry": { "oneOf": [{ "$ref": "#/$defs/shape" }, { "allOf": [{ "$ref": "#/$defs/repeat" }, { "properties": { "each": { "$ref": "#/$defs/shapeEntry" } } }] }] },
    "scoreEntry": { "oneOf": [{ "$ref": "#/$defs/score" }, { "allOf": [{ "$ref": "#/$defs/repeat" }, { "properties": { "each": { "$ref": "#/$defs/scoreEntry" } } }] }] },
    "box": {
      "type": "object", "required": ["kind", "name", "size", "faces"], "additionalProperties": false,
      "properties": {
        "kind": { "const": "box" }, "name": { "type": "string", "description": "May contain {expr} placeholders." },
        "size": { "$ref": "#/$defs/vec3" }, "at": { "$ref": "#/$defs/vec3" },
        "faces": { "oneOf": [{ "const": "all" }, { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/face" } }] },
        "shelves": {
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/$defs/expr" } },
            { "type": "object", "required": ["even", "h"], "additionalProperties": false, "properties": { "even": { "$ref": "#/$defs/expr" }, "h": { "$ref": "#/$defs/expr" }, "top": { "type": "boolean" } } }
          ]
        },
        "scores": { "type": "object", "propertyNames": { "$ref": "#/$defs/face" }, "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/scoreEntry" } } },
        "holes": { "type": "object", "propertyNames": { "$ref": "#/$defs/face" }, "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/shapeEntry" } } },
        "when": { "$ref": "#/$defs/expr" }, "material": { "type": "string" }
      }
    },
    "flat": {
      "type": "object", "required": ["kind", "name", "polys"], "additionalProperties": false,
      "properties": {
        "kind": { "const": "flat" }, "name": { "type": "string" },
        "polys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/shapeEntry" }, "description": "First shape is the outline, the rest are holes." },
        "scores": { "type": "array", "items": { "$ref": "#/$defs/scoreEntry" } },
        "plane": { "$ref": "#/$defs/plane" }, "wall": { "type": "boolean" }, "surface": { "type": "boolean" },
        "at": { "$ref": "#/$defs/vec3" }, "when": { "$ref": "#/$defs/expr" }, "material": { "type": "string" }
      }
    },
    "plane": {
      "type": "object", "minProperties": 1, "maxProperties": 1,
      "properties": {
        "upright": { "type": "object", "additionalProperties": false, "description": "Standing up, facing the front, at depth y.", "properties": { "x": { "$ref": "#/$defs/expr" }, "y": { "$ref": "#/$defs/expr" }, "z": { "$ref": "#/$defs/expr" } } },
        "floor": { "type": "object", "additionalProperties": false, "description": "Lying flat at height z.", "properties": { "z": { "$ref": "#/$defs/expr" } } },
        "custom": { "type": "object", "additionalProperties": false, "required": ["o", "U", "V", "n"], "properties": { "o": { "$ref": "#/$defs/vec3" }, "U": { "$ref": "#/$defs/vec3" }, "V": { "$ref": "#/$defs/vec3" }, "n": { "$ref": "#/$defs/vec3" } } }
      }
    },
    "args": { "type": "array", "items": { "$ref": "#/$defs/expr" } },
    "shape": {
      "type": "object", "minProperties": 1,
      "properties": {
        "rect": { "$ref": "#/$defs/args", "description": "[x, y, w, h]" },
        "arch": { "$ref": "#/$defs/args", "description": "[x, y, w, h, radius?, segments?]" },
        "ellipse": { "$ref": "#/$defs/args", "description": "[cx, cy, rx, ry, segments?]" },
        "circle": { "$ref": "#/$defs/args", "description": "[cx, cy, r, segments?]" },
        "plant": { "$ref": "#/$defs/args", "description": "[w, h, lobes?] leafy silhouette" },
        "drape": { "$ref": "#/$defs/args", "description": "[x, w, h] curtain panel with a wavy edge" },
        "poly": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/vec2" } },
        "when": { "$ref": "#/$defs/expr" }
      }
    },
    "score": {
      "type": "object", "minProperties": 1,
      "properties": {
        "line": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/vec2" } },
        "loop": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/vec2" } },
        "rect": { "$ref": "#/$defs/args", "description": "[x, y, w, h]" },
        "circle": { "$ref": "#/$defs/args", "description": "[cx, cy, r, segments?]" },
        "ellipse": { "$ref": "#/$defs/args", "description": "[cx, cy, rx, ry, segments?]" },
        "fronts": {
          "type": "object", "required": ["style", "count", "w", "h"], "additionalProperties": false,
          "description": "Drawer or door gap lines across a cabinet front.",
          "properties": { "style": { "$ref": "#/$defs/expr" }, "count": { "$ref": "#/$defs/expr" }, "w": { "$ref": "#/$defs/expr" }, "h": { "$ref": "#/$defs/expr" }, "from": { "$ref": "#/$defs/expr" }, "to": { "$ref": "#/$defs/expr" } }
        },
        "when": { "$ref": "#/$defs/expr" }
      }
    }
  }
}
